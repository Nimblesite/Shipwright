{
  "name": "@nimblesite/shipwright-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Shipwright core resolver and manifest helpers.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nimblesite/Shipwright.git"
  },
  "homepage": "https://github.com/Nimblesite/Shipwright",
  "keywords": ["shipwright", "deployment", "versioning", "ide-extension", "binary"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist/", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
