<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress CS1591 (missing XML doc) until we doc every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>DeployToolkit</PackageId>
    <Version>0.1.0</Version>
    <Authors>deploy-toolkit contributors</Authors>
    <Description>Generic binary resolver and version-manifest helpers for products adopting the deploy-toolkit contract.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/nimblesite/deployment_toolkit</RepositoryUrl>
  </PropertyGroup>
</Project>
