{
  "$schema": "https://deployment-toolkit.dev/schemas/deployment-toolkit/v1.json",
  "manifestVersion": 1,
  "product": {
    "id": "{{PRODUCT_ID}}",
    "displayName": "{{PRODUCT_ID}}",
    "version": "{{VERSION}}"
  },
  "components": [
    {
      "id": "{{BINARY_NAME}}",
      "kind": "cli",
      "language": "rust",
      "binaryName": "{{BINARY_NAME}}",
      "expectedVersion": "${PRODUCT_VERSION}",
      "platforms": ["darwin-arm64", "darwin-x64", "linux-x64", "linux-arm64", "win32-x64"],
      "sources": ["path", "pkgmgr"],
      "pkgmgr": {
        "brew": "{{ORG}}/tap/{{BINARY_NAME}}",
        "scoop": "{{ORG}}/{{BINARY_NAME}}"
      },
      "verifyStartup": true,
      "versionCheckStrategy": "version-flag",
      "required": true
    }
  ],
  "hosts": {
    "cli": { "artifact": "archive", "activationVerifies": ["{{BINARY_NAME}}"], "onMismatch": "error" },
    "pkgmgr": { "artifact": "brew-formula+scoop-manifest" }
  }
}
